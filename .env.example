# Backend API
API_PORT=4000

# Platform port override (e.g. Railway sets PORT automatically — takes priority over API_PORT)
# PORT=8080

# Node environment
# NODE_ENV=production

# PostgreSQL
# Development (Docker default):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mesa_recibos?schema=public"

# Production (Railway / managed Postgres):
# Add connection_limit to avoid exhausting Railway's connection pool on cold starts.
# DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public&connection_limit=5&pool_timeout=10"

# CORS allowed origins (comma-separated, production only)
# Leave empty in development — all origins are accepted.
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend logo.dev (public key — safe to expose)
VITE_LOGO_DEV_TOKEN="pk_J_6gnc2JTzKtdVlXmGyzvA"

# Gemini 3 Pro
GEMINI_API_KEY=your_gemini_api_key_here

